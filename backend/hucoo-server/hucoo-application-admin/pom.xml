<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.hucoo</groupId>
        <artifactId>hucoo-server</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>hucoo-application-admin</artifactId>
    <name>hucoo-application-admin</name>
    <description>Hucoo Agent Platform Admin application entry point</description>

    <dependencies>
        <dependency>
            <groupId>dev.hucoo</groupId>
            <artifactId>hucoo-module-tenant</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.hucoo</groupId>
            <artifactId>hucoo-module-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.hucoo</groupId>
            <artifactId>hucoo-module-model-governance</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.hucoo</groupId>
            <artifactId>hucoo-module-model-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.hucoo</groupId>
            <artifactId>hucoo-module-tool-mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.hucoo</groupId>
            <artifactId>hucoo-module-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.hucoo</groupId>
            <artifactId>hucoo-module-project</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.hucoo</groupId>
            <artifactId>hucoo-module-billing</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.hucoo</groupId>
            <artifactId>hucoo-module-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.hucoo</groupId>
            <artifactId>hucoo-module-security</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.hucoo</groupId>
            <artifactId>hucoo-module-monitoring</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.hucoo</groupId>
            <artifactId>hucoo-module-integration</artifactId>
        </dependency>

        <dependency>
            <groupId>dev.hucoo</groupId>
            <artifactId>hucoo-component-swagger</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
            Spring Boot 4 把 Flyway 自动配置拆到独立的 spring-boot-flyway 模块，
            只引 flyway-core 不会有任何自动配置，spring.flyway.* 属性全部静默失效、
            迁移不会执行。必须用 starter 引入自动配置。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>dev.hucoo</groupId>
            <artifactId>hucoo-component-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
