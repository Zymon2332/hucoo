# APP CONFIG
APP_SERVICE_PORT=2000
APP_WORKERS=1
APP_LOG_LEVEL=info
APP_ENV=dev

# DATABASE CONFIG
# 统一连接串，checkpointer / store / 业务表共用
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hucoo_agent_platform
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_ENGINE_POOL_SIZE=5
DATABASE_ENGINE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# CHECKPOINTER CONFIG
# backend: postgres（连接串见 DATABASE_URL）
CHECKPOINTER_BACKEND=postgres
CHECKPOINTER_AUTO_SETUP=true

# STORE CONFIG
# backend: postgres（连接串见 DATABASE_URL）
STORE_BACKEND=postgres
STORE_AUTO_SETUP=true

# LOGGING CONFIG
LOG_LEVEL=INFO
LOG_FILE=
LOG_INTERCEPT_STDLIB=true
