# APP CONFIG
APP_SERVICE_PORT=2000
APP_WORKERS=1
APP_LOG_LEVEL=info
APP_ENV=dev

# CHECKPOINTER CONFIG
# backend: memory | postgres（postgres 时 DB_URI 必填）
CHECKPOINTER_BACKEND=memory
CHECKPOINTER_DB_URI=
CHECKPOINTER_POOL_MIN_SIZE=1
CHECKPOINTER_POOL_MAX_SIZE=10
CHECKPOINTER_AUTO_SETUP=true

# STORE CONFIG
# backend: memory | postgres（postgres 时 DB_URI 必填）
STORE_BACKEND=memory
STORE_DB_URI=
STORE_POOL_MIN_SIZE=1
STORE_POOL_MAX_SIZE=10
STORE_AUTO_SETUP=true

# LOGGING CONFIG
LOG_LEVEL=INFO
LOG_FILE=
LOG_INTERCEPT_STDLIB=true
